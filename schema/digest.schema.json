{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jre-coder/expense-tracker-bridge/schema/digest.schema.json",
  "title": "Digest",
  "description": "The only object the Bridge sends about a pull request. Closed schema: any property not listed here is dropped by the Bridge before sending and rejected by the server. external_ref is an opaque hash (first 16 hex chars of sha256(repo_full_name + '#' + pr_number + merged_at)); the server cannot recover the repo, PR number or merge time from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["external_ref", "change_type", "title", "summary", "test_items", "addresses_feedback", "shipped_at", "bridge_version"],
  "properties": {
    "external_ref": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "change_type": { "type": "string", "enum": ["feature", "fix", "enhancement", "chore"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "test_items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "steps", "expected", "priority"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "steps": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "expected": { "type": "string", "minLength": 1, "maxLength": 300 },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "addresses_feedback": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" }
    },
    "shipped_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "bridge_version": { "type": "string", "minLength": 1, "maxLength": 32 }
  }
}
